#!/bin/bash
# mytel-phone-addext — add a MyTel WebPhone WebRTC endpoint to this Issabel PBX.
# Usage: mytel-phone-addext <extension> <secret>   (run as root)
# The endpoint registers ONLY over wss://PBX:8089/ws (transport-wss) and is
# appended to /etc/asterisk/pjsip_custom.conf. A dial rule is inserted INSIDE
# the existing [mytel-webphone] context of extensions_custom.conf (created
# only if absent). Existing custom configuration is never replaced.
# Both files are fully validated BEFORE anything is written; a later failure
# restores the pre-write copies.
set -euo pipefail

EXT="$1"
SECRET="$2"
PJSIP=/etc/asterisk/pjsip_custom.conf
DIAL=/etc/asterisk/extensions_custom.conf
CTX="mytel-webphone"

fail() { echo "$1" >&2; exit 1; }

[[ "$#" -eq 2 ]] || fail "usage: $0 <extension> <secret>"
[[ "$EXT" =~ ^[0-9]{2,6}$ ]] || fail "extension must be 2-6 digits"
# Asterisk config-safe secret: alnum only, 12..64 chars.
# Prevents ';' comments, newline injection and section-header spoofing.
# Generate compatible secrets with:  openssl rand -hex 16
[[ "$SECRET" =~ ^[A-Za-z0-9]{12,64}$ ]] || \
  fail "secret must be 12-64 alphanumeric characters (hint: openssl rand -hex 16)"

# ---------- validate EVERYTHING before writing (no partial updates) ----------
[[ -f "$PJSIP" ]] || fail "$PJSIP not found - create it from pjsip_custom.conf.example first"
[[ -f "$DIAL" ]] || fail "$DIAL not found"
grep -q "^\[mytel-webrtc\](!)" "$PJSIP" || \
  fail "endpoint template [mytel-webrtc](!) missing in $PJSIP - create it from the example first"
grep -q "^\[$EXT\]" "$PJSIP" && fail "endpoint $EXT already exists in $PJSIP"
asterisk -rx "pjsip show endpoints" | grep -qw "$EXT" && \
  fail "endpoint name $EXT already active in asterisk"
python3 - "$DIAL" "$EXT" "$CTX" <<'PYEOF'
import sys, re
path, ext, ctx = sys.argv[1], sys.argv[2], sys.argv[3]
lines = open(path).read().splitlines(True)
start = None
for i, l in enumerate(lines):
    if re.match(r'\s*\[%s\]' % re.escape(ctx), l):
        start = i
        break
if start is None:
    sys.exit(0)          # context will be created; nothing to collide
end = len(lines)
for j in range(start + 1, len(lines)):
    if re.match(r'\s*\[', lines[j]):
        end = j
        break
body = "".join(lines[start:end])
if re.search(r'^\s*exten\s*=>\s*%s\s*,' % re.escape(ext), body, re.M):
    sys.stderr.write("dial rule for %s already exists in [%s]\n" % (ext, ctx))
    sys.exit(1)
PYEOF
[[ $? -eq 0 ]] || exit 1

# ---------- snapshot for rollback ----------
PJSIP_BAK="$PJSIP.bak.$(date +%Y%m%d%H%M%S)"
DIAL_BAK="$DIAL.bak.$(date +%Y%m%d%H%M%S)"
restore() { cp -a "$PJSIP_BAK" "$PJSIP"; cp -a "$DIAL_BAK" "$DIAL"; }
trap 'ec=$?; [[ $ec -ne 0 ]] && restore; exit $ec' EXIT
cp -a "$PJSIP" "$PJSIP_BAK"
cp -a "$DIAL" "$DIAL_BAK"

# ---------- write pjsip endpoint ----------
cat >> "$PJSIP" <<EOF

[$EXT](mytel-webrtc)
auth=auth$EXT
aors=$EXT

[auth$EXT]
type=auth
auth_type=userpass
username=$EXT
password=$SECRET

[$EXT]
type=aor
max_contacts=6
remove_existing=no
EOF

# ---------- write dial rule inside the context (line-boundary safe) ----------
python3 - "$DIAL" "$EXT" "$CTX" <<'PYEOF'
import sys, re
path, ext, ctx = sys.argv[1], sys.argv[2], sys.argv[3]
lines = open(path).read().splitlines(True)
if lines and not lines[-1].endswith("\n"):
    lines[-1] += "\n"                       # guarantee a line boundary
rule = ("exten => %s,1,Dial(PJSIP/%s,30)\n"
        " same => n,Hangup()\n") % (ext, ext)
start = None
for i, l in enumerate(lines):
    if re.match(r'\s*\[%s\]' % re.escape(ctx), l):
        start = i
        break
if start is None:
    lines.append("[%s]\n" % ctx)
    lines.append(rule)
else:
    end = len(lines)
    for j in range(start + 1, len(lines)):
        if re.match(r'\s*\[', lines[j]):
            end = j
            break
    if not lines[end - 1].endswith("\n"):
        lines[end - 1] += "\n"
    lines.insert(end, rule)
open(path, "w").write("".join(lines))
PYEOF

asterisk -rx "pjsip reload" >/dev/null
asterisk -rx "dialplan reload" >/dev/null
trap - EXIT
echo "OK: $EXT added (wss-only, context $CTX)"
