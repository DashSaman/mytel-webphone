; MyTel WebPhone — WebRTC endpoints for Issabel 5 / Asterisk 20 (PJSIP)
; Copy to /etc/asterisk/pjsip_custom.conf and REPLACE the placeholder
; extensions/secrets with real values. NEVER commit real secrets.
; Apply with: asterisk -rx "pjsip reload"

[mytel-webrtc](!)
type=endpoint
transport=transport-wss
context=mytel-webphone
webrtc=yes
use_avpf=yes
media_encryption=dtls
dtls_auto_generate_cert=yes
dtls_verify=fingerprint
dtls_setup=actpass
ice_support=yes
rtcp_mux=yes
direct_media=no
force_rport=yes
rewrite_contact=yes
rtp_symmetric=yes
disallow=all
allow=opus
allow=ulaw
allow=alaw

[6001](mytel-webrtc)
auth=auth6001
aors=6001

[auth6001]
type=auth
auth_type=userpass
username=6001
password=REPLACE_WITH_STRONG_SECRET

[6001]
type=aor
max_contacts=6
remove_existing=no

[6002](mytel-webrtc)
auth=auth6002
aors=6002

[auth6002]
type=auth
auth_type=userpass
username=6002
password=REPLACE_WITH_STRONG_SECRET

[6002]
type=aor
max_contacts=6
remove_existing=no
